# Copy this file to .env and fill it in. .env is gitignored: never commit it.

# Claude credentials: fill in ONE of these two.
#
# Option A, Claude Pro/Max subscription (uses your plan's usage, no API billing).
# Generate the token inside the container, not on your machine:
#   docker run --rm -it --entrypoint claude contrib-agent setup-token
CLAUDE_CODE_OAUTH_TOKEN=
#
# Option B, API key from https://console.anthropic.com (billed per token).
ANTHROPIC_API_KEY=

# GitHub fine-grained token, limited to your fork (see README, "Docker").
# Not needed for --local-only.
GH_TOKEN=

# Author for the commit on your fork. Use your GitHub noreply address
# (GitHub -> Settings -> Emails) to keep your real email private.
GIT_USER_NAME=James Richardson
GIT_USER_EMAIL=
